{
  "name": "opencode-result",
  "version": "0.2.0",
  "description": "Result reports for the OpenCode TUI: the agent publishes a markdown summary with links and screenshots, shown in the sidebar and a large in-terminal viewer",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "license": "MIT",
  "author": "igorovh",
  "private": true,
  "homepage": "https://github.com/igorovh/opencode-result#readme",
  "bugs": {
    "url": "https://github.com/igorovh/opencode-result/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorovh/opencode-result.git"
  },
  "keywords": ["opencode", "opencode-plugin", "opentui", "tui", "terminal", "report", "markdown", "screenshots", "kitty-graphics", "sixel"],
  "engines": {
    "opencode": ">=2.2.5"
  },
  "files": ["src", "dist", "README.md", "LICENSE"],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./dist/tui.js",
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "compile": "bun script/compile.ts",
    "check:dist": "bun script/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": { "optional": true },
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@opencode/theme": "2.2.5",
    "@opentui/core": "0.8.2",
    "@opentui/solid": "0.8.2",
    "@types/bun": "1.4.4",
    "solid-js": "1.9.18",
    "typescript": "7.0.2"
  }
}
